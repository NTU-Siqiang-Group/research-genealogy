# Required for live corpus discovery. Create a free key at openalex.org.
OPENALEX_API_KEY=

# Optional: enables automatic first/corresponding-author homepage discovery
# when deterministic full-text routes fail.
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING=disabled

# Optional independent overrides for author-homepage search.
# AUTHOR_SEARCH_API_KEY=
# AUTHOR_SEARCH_BASE_URL=https://api.deepseek.com
# AUTHOR_SEARCH_MODEL=deepseek-v4-flash

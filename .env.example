# Required for live corpus discovery. Create a free key at openalex.org.
OPENALEX_API_KEY=

# Optional author-homepage fallback. Set exactly one key and the provider/model
# are selected automatically (OpenAI: gpt-5.4-mini; DeepSeek: v4 Flash).
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Set these when both provider keys exist or when overriding the defaults.
AUTHOR_SEARCH_PROVIDER=
AUTHOR_SEARCH_MODEL=

# Advanced: any endpoint implementing the Responses API web_search tool and
# JSON-schema structured output.
# AUTHOR_SEARCH_PROVIDER=openai_compatible
# AUTHOR_SEARCH_API_KEY=
# AUTHOR_SEARCH_BASE_URL=https://provider.example/v1
# AUTHOR_SEARCH_MODEL=provider-model

# Optional legacy semantic-profile extraction. It accepts openai, deepseek, or
# an OpenAI-compatible Chat Completions endpoint.
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=gpt-5.4-mini
# LLM_THINKING=disabled
